{
  "name": "nuxt-template",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "nuxt prepare && git config core.hooksPath .githooks",
    "dev": "nuxt dev",
    "dev:clean": "nuxt cleanup && nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "deploy": "nuxt generate && wrangler deploy",
    "lint": "eslint . --cache --cache-strategy content",
    "lint:fix": "eslint . --fix --cache --cache-strategy content",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:i18n": "node scripts/check-i18n-keys.mjs",
    "shared:status": "node scripts/shared-status.mjs",
    "fallow:audit": "fallow audit",
    "fallow:dead-code": "fallow dead-code",
    "fallow:dupes": "fallow dupes",
    "fallow:health": "fallow health --score --hotspots --targets",
    "fallow:security": "fallow security"
  },
  "dependencies": {
    "@iconify-json/circle-flags": "^1.2.14",
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/simple-icons": "^1.2.100",
    "@nuxt/a11y": "1.0.0-alpha.1",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@nuxtjs/seo": "^6.0.1",
    "@vueuse/nuxt": "^15.0.0",
    "nuxt": "^4.6.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.13.0",
    "eslint-plugin-better-tailwindcss": "^4.10.0",
    "fallow": "^3.40.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.158.0"
  },
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=26"
  },
  "volta": {
    "node": "26.13.0"
  }
}
